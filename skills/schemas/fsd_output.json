{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FSD Generator Output",
  "description": "约束 fsd-generator SubAgent 的结构化输出格式",
  "type": "object",
  "required": ["project_name", "features", "ssd_delta"],
  "properties": {
    "project_name": {
      "type": "string",
      "description": "项目名称"
    },
    "analysis_scope": {
      "type": "string",
      "enum": ["full", "single_feature", "module_scope"]
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["feature_id", "feature_name", "user_stories", "acceptance_criteria"],
        "properties": {
          "feature_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "description": "kebab-case 功能标识"
          },
          "feature_name": { "type": "string" },
          "priority": { "type": "string", "enum": ["P0", "P1", "P2", "P3"] },
          "user_stories": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["role", "action", "benefit"],
              "properties": {
                "id": { "type": "string", "pattern": "^US-\\d{2}$" },
                "role": { "type": "string" },
                "action": { "type": "string" },
                "benefit": { "type": "string" },
                "priority": { "type": "string", "enum": ["P0", "P1", "P2"] }
              }
            }
          },
          "data_entities": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "key_fields"],
              "properties": {
                "name": { "type": "string" },
                "key_fields": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "field": { "type": "string" },
                      "type": { "type": "string" },
                      "constraint": { "type": "string" }
                    }
                  }
                }
              }
            }
          },
          "api_endpoints": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["method", "path", "description"],
              "properties": {
                "method": { "type": "string", "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
                "path": { "type": "string" },
                "description": { "type": "string" },
                "input_schema": { "type": "object" },
                "output_schema": { "type": "object" }
              }
            }
          },
          "acceptance_criteria": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "object",
              "required": ["id", "description"],
              "properties": {
                "id": { "type": "string", "pattern": "^AC-\\d{2}$" },
                "description": { "type": "string" },
                "testable": { "type": "boolean", "default": true }
              }
            }
          },
          "non_functional": {
            "type": "object",
            "properties": {
              "performance": { "type": "string" },
              "security": { "type": "string" },
              "usability": { "type": "string" }
            }
          },
          "risks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "description": { "type": "string" },
                "impact": { "type": "string", "enum": ["low", "medium", "high"] },
                "mitigation": { "type": "string" }
              }
            }
          },
          "open_questions": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "ssd_delta": {
      "type": "object",
      "description": "SSD 系统概览增量更新",
      "properties": {
        "new_modules": { "type": "array", "items": { "type": "string" } },
        "updated_modules": { "type": "array", "items": { "type": "string" } },
        "architecture_notes": { "type": "string" }
      }
    }
  }
}