# ================================================================
# AI Harness Engineering — Environment Variables
# ================================================================
# Copy this file to .env and fill in your credentials

# ---------------------------------------------------------------
# Engine Server
# ---------------------------------------------------------------
HARNESS_HOST=0.0.0.0
HARNESS_PORT=8000

# ---------------------------------------------------------------
# OpenCode Server Connection
# ---------------------------------------------------------------
OPENCODE_HOST=127.0.0.1
OPENCODE_PORT=4096
OPENCODE_TIMEOUT=300

# ---------------------------------------------------------------
# 出站通知渠道（阶段更新 / CI/CD 审批卡片 / 完成/拒绝/错误通知）
# ---------------------------------------------------------------
# feishu — 飞书消息审批（默认）：interactive 卡片 + 按钮 approve/reject
# teams  — Microsoft Teams：incoming webhook + Power Automate 审批
# both   — 同时发送到 feishu 与 teams
# none   — 关闭出站通知（仅日志）
NOTIFY_CHANNEL=feishu

# 用于发送通知的飞书应用名（LARK_APPS_JSON 中 name 字段）；
# 为空时自动取第一个已配置的飞书应用
LARK_NOTIFY_APP=

# ---------------------------------------------------------------
# Microsoft Teams Integration
# ---------------------------------------------------------------
# Incoming webhook URL for your Teams channel
TEAMS_WEBHOOK_URL=https://prod-xxx.webhook.office.com/webhookb2/...

# Teams App ID
TEAMS_APP_ID=

# ---------------------------------------------------------------
# Lark (Feishu) Bot / App
# ---------------------------------------------------------------
# 多机器人场景（推荐）：一个机器人绑定一个 agent。
# LARK_APPS_JSON 为 JSON 数组，配置多个飞书应用时生效；
# 未配置时回退到下方的单应用环境变量。
#
# 每个应用的字段：
#   name           应用名（webhook 端点 /webhook/lark/<name> 使用，需唯一）
#   app_id         App ID（开发者后台：凭证与基础信息）
#   app_secret     App Secret
#   agent          该机器人绑定的处理 agent（如 harness-yunxiao-agent）
#   verification_token / encrypt_key  可选，覆盖全局配置
#
# LARK_APPS_JSON=[{"name":"yunxiao-bot","app_id":"cli_xxx","app_secret":"yyy","agent":"harness-yunxiao-agent"},{"name":"fsd-bot","app_id":"cli_zzz","app_secret":"www","agent":"harness-fsd"}]
LARK_APPS_JSON=

# 单应用场景（仅当 LARK_APPS_JSON 为空时生效）
# From the developer console: app Credentials & Basic Info
LARK_APP_ID=
LARK_APP_SECRET=

# Event & Callback page: Verification Token + Encrypt Key (optional)
LARK_VERIFICATION_TOKEN=
LARK_ENCRYPT_KEY=

# Message ingestion mode:
#   webhook   — event subscription, needs public URL + Encrypt Key recommended
#   websocket — long connection, no public URL needed (recommended)
LARK_EVENT_MODE=websocket

# open.feishu.cn (Feishu CN) or open.larksuite.com (Lark international)
LARK_DOMAIN=https://open.feishu.cn

# ---------------------------------------------------------------
# Power Automate
# ---------------------------------------------------------------
POWER_AUTOMATE_FLOW_APPROVAL=

# ---------------------------------------------------------------
# Defaults
# ---------------------------------------------------------------
HARNESS_MODEL=deepseek/deepseek-v4-pro
HARNESS_MAX_CLARIFY=10
